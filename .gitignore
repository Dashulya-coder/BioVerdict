# Secrets (keep .env.example tracked)
/.env
/.env.*
!/.env.example
/backend/.env
/backend/.env.*
!/backend/.env.example

# Backend (Python)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
/backend/*.egg-info/
/backend/dist/
/backend/build/

# Frontend (Node)
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/*.local
/frontend/coverage/
/frontend/.vite/
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/pnpm-debug.log*
/frontend/.pnpm-store/
*.tsbuildinfo

# Runtime data: SQLite, HTTP/LLM cache, run artifacts
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
# DB_PATH and CACHE_DIR default to data/... (.env.example): database, HTTP/LLM cache, runs
/data/
/eval/results/
/backend/data/
/.cache/
/backend/.cache/

# Tooling output
/graphify-out/
/.claude/

# Merge leftovers
*.orig
*.rej

# Logs
*.log
/logs/
/backend/logs/

# Editors and IDEs (any directory)
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.suo

# OS
.DS_Store
Thumbs.db
