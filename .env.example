# Copy to .env and fill in. Never commit .env.

# --- LLM providers (see docs/cost.md, ADR-004) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Primary provider/model per step and ordered failover list
LLM_PRIMARY=
LLM_FALLBACKS=

# --- Data sources (see docs/sources.md) ---
NCBI_API_KEY=
TAVILY_API_KEY=
# SEC EDGAR requires a descriptive User-Agent: "<name> <email>"
SEC_USER_AGENT=

# --- Run limits ---
RUN_BUDGET_USD=5
RUN_TIMEOUT_S=420

# --- Storage ---
DB_PATH=data/bioverdict.sqlite
CACHE_DIR=data/cache
