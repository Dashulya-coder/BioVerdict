# Copy to .env and fill in. Never commit .env.

# --- LLM providers (see docs/cost.md, ADR-004) ---
# Which provider a live run uses: `anthropic` or `openai` (the OpenAI-compatible hackathon
# gateway). Unset: the one whose key is set (Anthropic first).
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# The gateway: the team key from the organizers' portal and its base URL (ends with /v1).
# OPENAI_API_KEY is used if TEAM_API_KEY is empty.
TEAM_API_KEY=
LLM_BASE_URL=
# Characters one request may hold on the gateway (messages plus response schema). Measured at
# about 16,180; the default keeps a margin. 0 means no limit.
LLM_MAX_INPUT_CHARS=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Data sources (see docs/sources.md) ---
NCBI_API_KEY=
TAVILY_API_KEY=
# SEC EDGAR requires a descriptive User-Agent: "<name> <email>"
SEC_USER_AGENT=

# --- Run limits ---
RUN_BUDGET_USD=5
RUN_TIMEOUT_S=420
# How added evidence is recomputed: `classify` (default; the model places the new evidence, code
# recomputes) or `full` (every reasoning module runs again)
RECOMPUTE_MODE=classify

# --- Storage ---
DB_PATH=data/bioverdict.sqlite
CACHE_DIR=data/cache

# --- API ---
# Answer runs from fixtures/ (1) until the live pipeline is wired in
USE_FIXTURES=1
# Origins allowed to call the API from a browser, comma separated
CORS_ORIGINS=http://localhost:5173
