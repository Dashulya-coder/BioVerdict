      "locator": {
        "type": "pmid",
        "value": "40783289"
      },
      "excerpt": "median progression-free survival was 5·5 months (95% CI 4·5-6·7) with adagrasib and 3·8 months (95% CI 2·7-4·7) with docetaxel (hazard ratio 0·58 [95% CI 0·45-0·76]; p<0·0001)",
      "published_at": "2025-08-09",
      "retrieved_at": "2026-10-06T21:14:52Z",
