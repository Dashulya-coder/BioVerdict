      "excerpt": "{\"overallStatus\": \"ACTIVE_NOT_RECRUITING\", \"primaryCompletionDateStruct\": {\"date\": \"2026-05-19\", \"type\": \"ACTUAL\"}, \"lastUpdatePostDateStruct\": {\"date\": \"2026-09-16\", \"type\": \"ACTUAL\"}}",
